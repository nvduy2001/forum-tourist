SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME — bỏ trống thì fallback sqlite (chỉ dùng cho dev)
DATABASE_URL=postgres://forumtourist:forumtourist@localhost:5432/forumtourist

REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# Chưa có Celery worker/Redis chạy nền thật thì để True (task chạy đồng bộ, không cần broker)
CELERY_TASK_ALWAYS_EAGER=True

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Dev: console backend in email ra terminal thay vì gửi thật. Production đổi sang SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@forumtourist.local
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

CHECKIN_DISTANCE_THRESHOLD_M=300
